/*
 * Responsabilidade:
 * Arquivo de configuração base da aplicação. Armazena variáveis de ambiente,
 * credenciais de banco de dados, chaves secretas do JWT e configurações de log.
 * 
 * Papel na arquitetura:
 * Centraliza as configurações (Options Pattern do ASP.NET Core) para que a
 * aplicação não possua credenciais chumbadas (hardcoded) no código.
 */
{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=kaadebug-db;Username=kaadebug;Password=kaadebug@123"
  },
  "Jwt": {
    "Key": "your_super_secret_key_here_min_32_chars",
    "Issuer": "plantcare-api",
    "Audience": "plantcare-mobile",
    "ExpirationDays": 7
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}